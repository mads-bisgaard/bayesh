{
  "name": "Bayesh development",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "updateRemoteUserUID": true,
  "remoteUser": "ubuntu",
  "mounts": [
    "source=${localEnv:HOME}/.gitconfig,target=/home/ubuntu/.gitconfig-host,type=bind,readonly"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go"
      ]
    }
  }
}
